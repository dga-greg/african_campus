# ---- Runtime ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Number of reverse-proxy hops in front of the API (for correct client IPs / secure cookies)
TRUST_PROXY=0
# Public URL of the web application (used in e-mail links). The SPA and the API must be served
# from the same origin in production (e.g. https://heritage.example.org and https://heritage.example.org/api).
APP_ORIGIN=http://localhost:4200

# ---- Data stores ----
# MongoDB must be a replica set (transactions). docker-compose.yml starts a single-node one.
MONGODB_URI=mongodb://localhost:27017/family_heritage?replicaSet=rs0
# Optional in development, required in production (shared rate limits + background jobs).
REDIS_URL=redis://localhost:6379

# ---- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ----
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
CSRF_SECRET=change-me-to-another-long-random-string-of-32-chars

# ---- Sessions ----
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_LIFETIME_DAYS=90
# Defaults to true when NODE_ENV=production
COOKIE_SECURE=false

# ---- Password hashing (Argon2id) ----
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

# ---- Rate limits ----
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_15_MINUTES=10

# ---- E-mail ----
# Leave empty in development to log e-mails instead of sending them. Required in production.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Family Heritage <no-reply@heritage.example.org>"
